generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum MemberRole {
  OWNER
  MANAGER
  TECHNICIAN
  SERVICE_ADVISOR
  ACCOUNTANT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_REVOKED
  ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_ACTIVATED
  MEMBER_DEACTIVATED
  PASSWORD_RESET_REQUESTED
  FILE_UPLOADED
  FILE_DELETED
  SETTINGS_UPDATED
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER
}

enum DiagnosticUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  QUOTE_APPROVED
  QUOTE_REJECTED
  LOW_STOCK
  WORK_ORDER_ASSIGNED
  WORK_ORDER_STATUS_CHANGED
  WORK_ORDER_COMPLETED
  MEMBER_INVITED
  MEMBER_JOINED
  SYSTEM
}

enum CommChannel {
  WHATSAPP
  SMS
  EMAIL
  PHONE
}

enum CommDirection {
  OUTBOUND
  INBOUND
}

enum MigrationBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum MigrationLogAction {
  CREATED
  UPDATED
  SKIPPED
  FAILED
  ROLLED_BACK
}

enum QuoteRequestServiceType {
  PERIODIC_SERVICE
  BRAKES
  BATTERY
  TIRES
  AC
  CHECK_ENGINE
  DIAGNOSTICS
  OTHER
}

enum QuoteRequestUrgency {
  LOW
  NORMAL
  HIGH
}

enum QuoteRequestStatus {
  PENDING    // submitted, quote being generated
  REVIEWING  // auto-quote ready, waiting for garage approval
  SENT       // quote sent to customer
  RESOLVED   // approved or rejected by customer
  CANCELLED
}

// ─── Org / Auth ───────────────────────────────────────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  phone       String?
  address     String?
  city        String?
  country     String    @default("IL")
  timezone    String    @default("Asia/Jerusalem")
  vatId       String?
  website     String?
  plan             PlanType  @default(FREE)
  planExpiry       DateTime?
  trialEndsAt      DateTime?
  billingEmail     String?
  stripeCustomerId String?
  settings         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  defaultLaborRate   Decimal   @default(295) @db.Decimal(10, 2)

  members            Membership[]
  invitations        Invitation[]
  customers          Customer[]
  vehicles           Vehicle[]
  workOrders         WorkOrder[]
  parts              Part[]
  suppliers          Supplier[]
  quotes             Quote[]
  diagnosticSessions DiagnosticSession[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  commLogs           CommLog[]
  paymentLinks       PaymentLink[]
  clockEntries       ClockEntry[]
  migrationPresets   MigrationPreset[]
  migrationBatches   MigrationBatch[]
  quoteRequests      QuoteRequest[]
  aiQuoteAnalyses    AiQuoteAnalysis[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(TECHNICIAN)
  isActive       Boolean      @default(true)
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole   @default(TECHNICIAN)
  token          String       @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedBy      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  avatarUrl    String?
  phone        String?
  department   String?
  position     String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  memberships   Membership[]
  notifications Notification[]
  clockEntries  ClockEntry[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  entityType     String?
  entityId       String?
  actionUrl      String?
  read           Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  userEmail      String?
  userName       String?
  action         AuditAction
  entityType     String
  entityId       String?
  entityLabel    String?
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([userId])
}

// ─── Customers / Vehicles ─────────────────────────────────────────────────────

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  address        String?
  notes          String?
  vehicles       Vehicle[]
  workOrders     WorkOrder[]
  invoices       Invoice[]
  quotes         Quote[]
  commLogs       CommLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Vehicle {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plate              String
  make               String
  model              String
  year               Int
  color              String?
  vin                String?
  engine             String?
  fuelType           FuelType?
  transmission       Transmission?
  mileage            Int?
  notes              String?
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id])
  workOrders         WorkOrder[]
  quotes             Quote[]
  media              MediaFile[]
  diagnosticSessions DiagnosticSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([plate, organizationId])
  @@index([organizationId])
}

// ─── Work Orders ──────────────────────────────────────────────────────────────

model WorkOrder {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderNumber    String
  status             WorkOrderStatus     @default(PENDING)
  complaint          String?
  diagnosis          String?
  laborHours         Decimal             @default(0) @db.Decimal(8, 2)
  laborRate          Decimal             @default(150) @db.Decimal(10, 2)
  partsTotal         Decimal             @default(0) @db.Decimal(10, 2)
  totalPrice         Decimal             @default(0) @db.Decimal(10, 2)
  assignedTechnician String?
  mileage            Int?
  notes              String?
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id])
  vehicleId          String
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id])
  items                WorkOrderItem[]
  invoice              Invoice?
  quote                Quote?
  quoteRequest         QuoteRequest?
  techNotes            TechnicianNote[]
  media                MediaFile[]
  aiQuoteAnalyses      AiQuoteAnalysis[]
  diagnosticSessions   DiagnosticSession[]
  timeEntries          TimeEntry[]
  commLogs             CommLog[]
  paymentLinks         PaymentLink[]
  completedAt          DateTime?
  receivedAt           DateTime?
  signatureUrl         String?
  assignedTechnicianId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([workOrderNumber, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([assignedTechnicianId])
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String?
  part        Part?     @relation(fields: [partId], references: [id])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  parts          Part[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Part {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  category       String?
  manufacturer   String?
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  costPrice      Decimal         @db.Decimal(10, 2)
  salePrice      Decimal         @db.Decimal(10, 2)
  quantity       Int             @default(0)
  minQuantity    Int             @default(5)
  location       String?
  notes          String?
  items          WorkOrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([sku, organizationId])
  @@index([organizationId])
}

model StockMovement {
  id        String       @id @default(cuid())
  type      MovementType
  quantity  Int
  reason    String?
  partId    String
  part      Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

// ─── Quotes ───────────────────────────────────────────────────────────────────

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteNumber    String
  status         QuoteStatus  @default(DRAFT)
  laborHours     Decimal      @default(0) @db.Decimal(8, 2)
  laborRate      Decimal      @default(150) @db.Decimal(10, 2)
  partsTotal     Decimal      @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal      @default(0) @db.Decimal(10, 2)
  notes          String?
  validUntil     DateTime?
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  workOrderId    String?      @unique
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])
  isEstimate     Boolean      @default(false)
  items          QuoteItem[]
  media          MediaFile[]
  aiAnalysis     AiQuoteAnalysis?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([quoteNumber, organizationId])
  @@index([organizationId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ─── Media / Notes / Diagnostics ─────────────────────────────────────────────

model MediaFile {
  id           String     @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  phase        String?    // 'before' | 'during' | 'after' — null = general
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  quoteId      String?
  quote        Quote?     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedBy   String?
  createdAt    DateTime   @default(now())
}

model TechnicianNote {
  id          String         @id @default(cuid())
  content     String
  visibility  NoteVisibility @default(INTERNAL)
  authorName  String?
  workOrderId String
  workOrder   WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
}

model DiagnosticSession {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  complaint      String
  obdCodes       String?
  symptoms       String?
  aiResponse     String?
  urgency        DiagnosticUrgency @default(MEDIUM)
  vehicleId      String?
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])
  workOrderId    String?
  workOrder      WorkOrder?        @relation(fields: [workOrderId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([organizationId])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  workOrderId    String?       @unique
  workOrder      WorkOrder?    @relation(fields: [workOrderId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  paymentLinks PaymentLink[]

  @@unique([number, organizationId])
  @@index([organizationId])
}

// ─── Time Tracking ────────────────────────────────────────────────────────────

model TimeEntry {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  techName    String
  techId      String?
  startedAt   DateTime
  pausedAt    DateTime?
  finishedAt  DateTime?
  durationMin Int        @default(0)
  notes       String?
  createdAt   DateTime   @default(now())

  @@index([workOrderId])
  @@index([techId])
}

// ─── Communication Log ────────────────────────────────────────────────────────

model CommLog {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  workOrderId    String?
  workOrder      WorkOrder?    @relation(fields: [workOrderId], references: [id])
  channel        CommChannel   @default(WHATSAPP)
  direction      CommDirection @default(OUTBOUND)
  templateType   String?
  message        String
  recipientPhone String?
  sentAt         DateTime      @default(now())
  deliveredAt    DateTime?

  @@index([organizationId, sentAt(sort: Desc)])
  @@index([customerId])
  @@index([workOrderId])
}

// ─── Payment Links ────────────────────────────────────────────────────────────

model PaymentLink {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId       String?
  workOrder         WorkOrder?   @relation(fields: [workOrderId], references: [id])
  invoiceId         String?
  invoice           Invoice?     @relation(fields: [invoiceId], references: [id])
  amount            Decimal      @db.Decimal(10, 2)
  currency          String       @default("ILS")
  token             String       @unique @default(cuid())
  description       String?
  paidAt            DateTime?
  expiresAt         DateTime?
  stripeSessionId   String?      // Stripe Checkout session ID when using Stripe
  stripePaymentIntent String?    // Stripe PaymentIntent ID after confirmation
  createdAt         DateTime     @default(now())

  @@index([organizationId])
  @@index([token])
}

// ─── Israeli Vehicle Registry Cache ──────────────────────────────────────────
//
// Caches results from https://data.gov.il/dataset/ovdim so we don't hammer
// the government API on every keypress.  TTL = 30 days (checked at read time).

model VehicleLookupCache {
  id        String   @id @default(cuid())
  plate     String   @unique   // normalized: digits only, no dashes
  data      Json               // VehicleLookupResult
  source    String   @default("gov_il")
  fetchedAt DateTime @default(now())

  @@index([plate])
}

// ─── Staff Clock Entries ──────────────────────────────────────────────────────

model ClockEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockedInAt    DateTime
  clockedOutAt   DateTime?
  breakMinutes   Int          @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, clockedInAt(sort: Desc)])
  @@index([userId, clockedInAt(sort: Desc)])
}

// ─── Job Queue (retry queue for async tasks) ──────────────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model JobQueue {
  id          String    @id @default(cuid())
  type        String    // e.g. "send_whatsapp", "send_email", "generate_pdf"
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  runAt       DateTime  @default(now())  // earliest time to try
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
}

// ─── Quote Requests (customer-initiated) ─────────────────────────────────────

model QuoteRequest {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String                  @unique
  workOrder      WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  serviceType    QuoteRequestServiceType
  description    String?
  urgency        QuoteRequestUrgency     @default(NORMAL)
  status         QuoteRequestStatus      @default(PENDING)
  media          QuoteRequestMedia[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
}

model QuoteRequestMedia {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  url            String
  mimeType       String
  originalName   String
  createdAt      DateTime     @default(now())
}

// ─── Migration Connector ──────────────────────────────────────────────────────
//
// Tracks mapping presets, import batches, and per-row logs for the
// Hanesher SQL Server → GarageOS migration tool.

model MigrationPreset {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  sourceTable       String
  targetEntity      String       // "customer"|"vehicle"|"supplier"|"part"|"work_order"|"invoice"|"quote"
  columnMappings    Json         // ColumnMapping[]
  filterSql         String?      // optional WHERE clause appended to source query
  incrementalColumn String?      // e.g. "updated_at" — used for incremental sync
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
}

model MigrationBatch {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  userName       String?
  status         MigrationBatchStatus @default(PENDING)
  isDryRun       Boolean              @default(false)
  isIncremental  Boolean              @default(false)
  presetsUsed    Json                 // string[] of preset names
  totalRows      Int                  @default(0)
  imported       Int                  @default(0)
  skipped        Int                  @default(0)
  failed         Int                  @default(0)
  rolledBack     Boolean              @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())

  logs MigrationLog[]

  @@index([organizationId, createdAt(sort: Desc)])
}

model MigrationLog {
  id        String             @id @default(cuid())
  batchId   String
  batch     MigrationBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entity    String             // "customer"|"vehicle"|etc.
  sourceId  String?            // source PK value
  targetId  String?            // GarageOS record id (when created)
  action    MigrationLogAction
  message   String?
  rowData   Json?              // source row snapshot (for dry-run review)
  createdAt DateTime           @default(now())

  @@index([batchId, createdAt(sort: Desc)])
  @@index([entity, action])
}

// ─── Maintenance Schedules ────────────────────────────────────────────────────
//
// Structured service schedule rules per vehicle variant.
// Matched by make / model / year range / fuelType / transmission.
// Used by the periodic-service quote engine as the authoritative source.
// AI may explain or fill gaps but never overrides these rules.

model MaintenanceSchedule {
  id             String    @id @default(cuid())
  make           String    // "Toyota" — case-insensitive match at query time
  model          String    // "Corolla"
  yearFrom       Int       // first model year this schedule applies to (inclusive)
  yearTo         Int       // last model year (inclusive)
  fuelType       String?   // FuelType enum value or null = matches any fuel
  transmission   String?   // Transmission enum value or null = matches any
  intervalKm     Int       // service interval in km  (e.g. 60000)
  intervalMonths Int?      // optional time-based interval
  notes          String?   // shown on the schedule card (Hebrew)
  items          MaintenanceItem[]
  createdAt      DateTime  @default(now())

  @@index([make, model])
  @@index([make, model, fuelType])
}

model MaintenanceItem {
  id          String              @id @default(cuid())
  scheduleId  String
  schedule    MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  // OIL | FILTER_OIL | FILTER_AIR | FILTER_CABIN | FILTER_FUEL |
  // SPARK_PLUGS | GLOW_PLUGS | BRAKE_FLUID | GEARBOX_OIL | INSPECTION
  category    String
  nameHe      String              // Hebrew display name
  quantity    Int                 @default(1)
  unitPrice   Decimal             @db.Decimal(10,2)  // ILS before VAT
  laborHours  Decimal             @db.Decimal(5,2)   @default(0)
  required    Boolean             @default(true)     // false = optional / recommended
  notes       String?
  sortOrder   Int                 @default(0)

  @@index([scheduleId, sortOrder])
}

// ─── AI Quote Analysis ────────────────────────────────────────────────────────
//
// Stores every AI-powered complaint analysis: inputs, raw Claude response,
// structured results, cost calculations, and the resulting Quote (if created).

model AiQuoteAnalysis {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // ── Context ──────────────────────────────────────────────────────────────
  workOrderId    String?
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])
  vehiclePlate   String?
  vehicleMake    String?
  vehicleModel   String?
  vehicleYear    Int?
  vehicleMileage Int?

  // ── Input captured ───────────────────────────────────────────────────────
  complaintText  String       @db.Text
  photoUrls      Json         @default("[]")   // string[]

  // ── AI raw response ───────────────────────────────────────────────────────
  rawResponse    Json

  // ── Structured AI output ──────────────────────────────────────────────────
  diagnosis      String       @db.Text
  confidence     Float                          // 0.0 – 1.0
  urgency        String                         // low | medium | high | critical
  laborOperations Json                          // LaborOperation[]
  totalLaborHours Float
  partsRecommended Json                         // PartRecommendation[]
  additionalChecks Json        @default("[]")   // string[]
  safetyWarning  String?
  aiNotes        String?       @db.Text

  // ── Cost calculation (snapshot of rates at analysis time) ─────────────────
  laborRateUsed  Decimal       @db.Decimal(10, 2)
  laborTotal     Decimal       @db.Decimal(10, 2)
  partsTotal     Decimal       @db.Decimal(10, 2)
  subtotal       Decimal       @db.Decimal(10, 2)
  vatAmount      Decimal       @db.Decimal(10, 2)
  totalEstimate  Decimal       @db.Decimal(10, 2)

  // ── AI call metadata ───────────────────────────────────────────────────────
  modelUsed      String        @default("claude-opus-4-5")
  inputTokens    Int?
  outputTokens   Int?
  processingMs   Int?

  // ── Resulting quote (set when staff creates the draft) ────────────────────
  quoteId        String?       @unique
  quote          Quote?        @relation(fields: [quoteId], references: [id])

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([workOrderId])
}
