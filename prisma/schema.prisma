generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum MemberRole {
  OWNER
  MANAGER
  TECHNICIAN
  SERVICE_ADVISOR
  ACCOUNTANT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_REVOKED
  ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_ACTIVATED
  MEMBER_DEACTIVATED
  PASSWORD_RESET_REQUESTED
  FILE_UPLOADED
  FILE_DELETED
  SETTINGS_UPDATED
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER
}

enum DiagnosticUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Org / Auth ───────────────────────────────────────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  phone       String?
  address     String?
  city        String?
  country     String    @default("IL")
  timezone    String    @default("Asia/Jerusalem")
  vatId       String?
  website     String?
  plan        PlanType  @default(FREE)
  planExpiry  DateTime?
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members            Membership[]
  invitations        Invitation[]
  customers          Customer[]
  vehicles           Vehicle[]
  workOrders         WorkOrder[]
  parts              Part[]
  suppliers          Supplier[]
  quotes             Quote[]
  diagnosticSessions DiagnosticSession[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(TECHNICIAN)
  isActive       Boolean      @default(true)
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole   @default(TECHNICIAN)
  token          String       @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedBy      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  avatarUrl    String?
  phone        String?
  department   String?
  position     String?
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  userEmail      String?
  userName       String?
  action         AuditAction
  entityType     String
  entityId       String?
  entityLabel    String?
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([userId])
}

// ─── Customers / Vehicles ─────────────────────────────────────────────────────

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  address        String?
  notes          String?
  vehicles       Vehicle[]
  workOrders     WorkOrder[]
  invoices       Invoice[]
  quotes         Quote[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Vehicle {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plate              String
  make               String
  model              String
  year               Int
  color              String?
  vin                String?
  engine             String?
  fuelType           FuelType?
  transmission       Transmission?
  mileage            Int?
  notes              String?
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id])
  workOrders         WorkOrder[]
  quotes             Quote[]
  media              MediaFile[]
  diagnosticSessions DiagnosticSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([plate, organizationId])
  @@index([organizationId])
}

// ─── Work Orders ──────────────────────────────────────────────────────────────

model WorkOrder {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderNumber    String
  status             WorkOrderStatus     @default(PENDING)
  complaint          String?
  diagnosis          String?
  laborHours         Decimal             @default(0) @db.Decimal(8, 2)
  laborRate          Decimal             @default(150) @db.Decimal(10, 2)
  partsTotal         Decimal             @default(0) @db.Decimal(10, 2)
  totalPrice         Decimal             @default(0) @db.Decimal(10, 2)
  assignedTechnician String?
  mileage            Int?
  notes              String?
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id])
  vehicleId          String
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id])
  items              WorkOrderItem[]
  invoice            Invoice?
  quote              Quote?
  techNotes          TechnicianNote[]
  media              MediaFile[]
  diagnosticSessions DiagnosticSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([workOrderNumber, organizationId])
  @@index([organizationId])
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String?
  part        Part?     @relation(fields: [partId], references: [id])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  parts          Part[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Part {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  category       String?
  manufacturer   String?
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  costPrice      Decimal         @db.Decimal(10, 2)
  salePrice      Decimal         @db.Decimal(10, 2)
  quantity       Int             @default(0)
  minQuantity    Int             @default(5)
  location       String?
  notes          String?
  items          WorkOrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([sku, organizationId])
  @@index([organizationId])
}

model StockMovement {
  id        String       @id @default(cuid())
  type      MovementType
  quantity  Int
  reason    String?
  partId    String
  part      Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

// ─── Quotes ───────────────────────────────────────────────────────────────────

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteNumber    String
  status         QuoteStatus  @default(DRAFT)
  laborHours     Decimal      @default(0) @db.Decimal(8, 2)
  laborRate      Decimal      @default(150) @db.Decimal(10, 2)
  partsTotal     Decimal      @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal      @default(0) @db.Decimal(10, 2)
  notes          String?
  validUntil     DateTime?
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  workOrderId    String?      @unique
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])
  items          QuoteItem[]
  media          MediaFile[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([quoteNumber, organizationId])
  @@index([organizationId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ─── Media / Notes / Diagnostics ─────────────────────────────────────────────

model MediaFile {
  id           String     @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  quoteId      String?
  quote        Quote?     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedBy   String?
  createdAt    DateTime   @default(now())
}

model TechnicianNote {
  id          String         @id @default(cuid())
  content     String
  visibility  NoteVisibility @default(INTERNAL)
  authorName  String?
  workOrderId String
  workOrder   WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
}

model DiagnosticSession {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  complaint      String
  obdCodes       String?
  symptoms       String?
  aiResponse     String?
  urgency        DiagnosticUrgency @default(MEDIUM)
  vehicleId      String?
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])
  workOrderId    String?
  workOrder      WorkOrder?        @relation(fields: [workOrderId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([organizationId])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  workOrderId    String?       @unique
  workOrder      WorkOrder?    @relation(fields: [workOrderId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([number, organizationId])
  @@index([organizationId])
}
