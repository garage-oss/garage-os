generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MECHANIC
  RECEPTIONIST
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER
}

enum DiagnosticUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(MECHANIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id         String      @id @default(cuid())
  name       String
  phone      String
  email      String?
  address    String?
  notes      String?
  vehicles   Vehicle[]
  workOrders WorkOrder[]
  invoices   Invoice[]
  quotes     Quote[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Vehicle {
  id                  String              @id @default(cuid())
  plate               String              @unique
  make                String
  model               String
  year                Int
  color               String?
  vin                 String?
  engine              String?
  fuelType            FuelType?
  transmission        Transmission?
  mileage             Int?
  notes               String?
  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id])
  workOrders          WorkOrder[]
  quotes              Quote[]
  media               MediaFile[]
  diagnosticSessions  DiagnosticSession[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model WorkOrder {
  id                  String              @id @default(cuid())
  workOrderNumber     String              @unique
  status              WorkOrderStatus     @default(PENDING)
  complaint           String?
  diagnosis           String?
  laborHours          Decimal             @default(0) @db.Decimal(8, 2)
  laborRate           Decimal             @default(150) @db.Decimal(10, 2)
  partsTotal          Decimal             @default(0) @db.Decimal(10, 2)
  totalPrice          Decimal             @default(0) @db.Decimal(10, 2)
  assignedTechnician  String?
  mileage             Int?
  notes               String?
  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id])
  vehicleId           String
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id])
  items               WorkOrderItem[]
  invoice             Invoice?
  quote               Quote?
  techNotes           TechnicianNote[]
  media               MediaFile[]
  diagnosticSessions  DiagnosticSession[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String?
  part        Part?     @relation(fields: [partId], references: [id])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  parts       Part[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Part {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  category       String?
  manufacturer   String?
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  costPrice      Decimal         @db.Decimal(10, 2)
  salePrice      Decimal         @db.Decimal(10, 2)
  quantity       Int             @default(0)
  minQuantity    Int             @default(5)
  location       String?
  notes          String?
  items          WorkOrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model StockMovement {
  id        String       @id @default(cuid())
  type      MovementType
  quantity  Int
  reason    String?
  partId    String
  part      Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)
  laborHours  Decimal     @default(0) @db.Decimal(8, 2)
  laborRate   Decimal     @default(150) @db.Decimal(10, 2)
  partsTotal  Decimal     @default(0) @db.Decimal(10, 2)
  totalPrice  Decimal     @default(0) @db.Decimal(10, 2)
  notes       String?
  validUntil  DateTime?
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id])
  workOrderId String?     @unique
  workOrder   WorkOrder?  @relation(fields: [workOrderId], references: [id])
  items       QuoteItem[]
  media       MediaFile[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model MediaFile {
  id           String     @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  quoteId      String?
  quote        Quote?     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedBy   String?
  createdAt    DateTime   @default(now())
}

model TechnicianNote {
  id          String         @id @default(cuid())
  content     String
  visibility  NoteVisibility @default(INTERNAL)
  authorName  String?
  workOrderId String
  workOrder   WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
}

model DiagnosticSession {
  id          String             @id @default(cuid())
  complaint   String
  obdCodes    String?
  symptoms    String?
  aiResponse  String?
  urgency     DiagnosticUrgency  @default(MEDIUM)
  vehicleId   String?
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id])
  workOrderId String?
  workOrder   WorkOrder?         @relation(fields: [workOrderId], references: [id])
  createdAt   DateTime           @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @db.Decimal(10, 2)
  tax         Decimal       @default(0) @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  notes       String?
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  workOrderId String?       @unique
  workOrder   WorkOrder?    @relation(fields: [workOrderId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
