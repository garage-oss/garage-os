# ──────────────────────────────────────────────────────────────────────────────
# GarageOS — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/garagedb"
NEXTAUTH_SECRET="minimum-32-character-random-string-change-me"
NEXTAUTH_URL="https://your-app-domain.com"

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000
SESSION_TIMEOUT_MINUTES=480

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION="us-east-1"
# AWS_S3_PUBLIC_URL=""
# AWS_S3_ENDPOINT=""

# ── Twilio ────────────────────────────────────────────────────────────────────
# FLAG_TWILIO_WHATSAPP="false"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ── Stripe ────────────────────────────────────────────────────────────────────
# FLAG_STRIPE_PAYMENTS="false"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── SMTP ──────────────────────────────────────────────────────────────────────
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@your-garage.com"
# SMTP_SECURE="false"

# ── Security ──────────────────────────────────────────────────────────────────
# ENCRYPTION_KEY=""  # openssl rand -hex 32

# ── AI ────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=""

# ── Monitoring ────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# SENTRY_DSN=""

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Cron ──────────────────────────────────────────────────────────────────────
# CRON_SECRET=""

# ── Feature flags ─────────────────────────────────────────────────────────────
FLAG_AI_DIAGNOSTICS="true"
FLAG_AUDIT_LOG="true"
FLAG_AVATAR_UPLOAD="true"
FLAG_ADVANCED_REPORTS="false"
FLAG_BILLING_PORTAL="false"
FLAG_TWILIO_WHATSAPP="false"
FLAG_STRIPE_PAYMENTS="false"
