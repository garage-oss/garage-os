# ─────────────────────────────────────────────────────────────────────────────
# GarageOS — Environment Variables Reference
#
# Copy this file to .env (for local dev) or set these in your deployment
# platform (Vercel, Railway, Render, etc.).
#
# Full documentation: docs/environment.md
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local:    postgresql://postgres:password@localhost:5432/garagedb
# Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/garagedb?sslmode=require
# Supabase: postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/garagedb

# NextAuth secret — used to sign JWTs and encrypt cookies.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-at-least-32-characters-long

# Public URL of your app — no trailing slash.
NEXTAUTH_URL=http://localhost:3000


# ── Storage ───────────────────────────────────────────────────────────────────

# Values: local | s3 | supabase
# WARNING: "local" is ephemeral on Vercel/Railway. Use s3 or supabase in prod.
STORAGE_PROVIDER=local

# S3 / Cloudflare R2 / MinIO (required when STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_S3_BUCKET=garageos-uploads
# AWS_REGION=eu-central-1
# AWS_S3_PUBLIC_URL=https://cdn.yourdomain.com

# Supabase Storage (required when STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGci...
# SUPABASE_STORAGE_BUCKET=avatars


# ── AI ────────────────────────────────────────────────────────────────────────

# Anthropic API key — required for AI Diagnostics feature.
# ANTHROPIC_API_KEY=sk-ant-...


# ── Monitoring ────────────────────────────────────────────────────────────────

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Sentry DSN — error tracking and performance monitoring.
# SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz


# ── Rate limiting ─────────────────────────────────────────────────────────────

# Upstash Redis — required for multi-instance rate limiting.
# Without this, an in-memory limiter is used (single-instance only).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...


# ── Feature flags ─────────────────────────────────────────────────────────────

FLAG_AI_DIAGNOSTICS=true
FLAG_AUDIT_LOG=true
FLAG_AVATAR_UPLOAD=true
FLAG_ADVANCED_REPORTS=false
FLAG_BILLING_PORTAL=false


# ── Build / CI ────────────────────────────────────────────────────────────────

# Set to "true" only in CI build steps — never in production.
# SKIP_ENV_VALIDATION=false
