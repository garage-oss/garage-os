{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "Bash(npm -v)",
      "PowerShell(Get-ChildItem -Recurse -File | Where-Object { $_.FullName -notmatch 'node_modules|\\\\.next|\\\\.git' } | Select-Object -ExpandProperty FullName | Sort-Object)",
      "Read(//mnt/c/**)",
      "Bash(npm install *)",
      "PowerShell(npm install)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  }
}
